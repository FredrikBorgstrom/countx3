# API (apps/api)
DATABASE_URL=postgres://countx3_app:countx3_app@localhost/countx3_dev
PORT=8787
PUBLIC_URL=http://localhost:8787
# Comma-separated browser origins; unset in development = any localhost port plus the Capacitor/Tauri origins.
# CORS_ORIGINS=https://app.example.com,capacitor://localhost,https://localhost,tauri://localhost,http://tauri.localhost

# Migrations (packages/db) run as the schema owner, never as the runtime role.
DATABASE_OWNER_URL=postgres://countx3_owner:countx3_owner@localhost/countx3_dev

# Web, mobile and desktop builds (apps/web)
VITE_API_URL=http://localhost:8787

# CLI and agents (apps/cli)
# COUNTX3_URL=http://localhost:8787
# COUNTX3_TOKEN=cx3_…
# COUNTX3_COMPANY=<company id>
